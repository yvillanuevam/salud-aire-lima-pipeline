# =====================================================================
# Plantilla de configuracion local. NO pongas valores reales aqui.
#
#   Windows:  .\scripts\preparar_env.ps1     (crea .env y genera secretos)
#   Linux/Mac: ./scripts/preparar_env.sh
#
# Luego edita SOLO la seccion "Tus credenciales" del archivo .env.
# .env esta en .gitignore: nunca se sube a Git.
#
# IMPORTANTE: en las contrasenas evita comillas dobles ("), barra invertida (\)
# y el signo $, porque docker compose las interpreta.
# =====================================================================

# --- Ejecucion de contenedores ---
# Windows: deja 50000. Linux: usa el resultado de `id -u`.
AIRFLOW_UID=50000

# Puerto de la UI de Airflow en tu PC (cambialo si 8080 ya esta en uso).
AIRFLOW_PORT=8080
# Tareas simultaneas de Airflow (4 para ~6 GB de RAM en Docker; 8 con 10 GB o mas).
AIRFLOW_PARALELISMO=4

# --- Secretos internos (los genera el script preparar_env) ---
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_DB_PASSWORD=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
MINIO_AIRFLOW_ACCESS_KEY=airflow-datalake
MINIO_AIRFLOW_SECRET_KEY=

# --- Tus credenciales (completa a mano) ---
# Snowflake: account con formato identificador.region, ej. ab12345.us-east-1
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=

# OpenAQ: crea tu API key gratis en https://explore.openaq.org/register
OPENAQ_API_KEY=

# Fuente de calidad del aire: "openaq" (API real) o "simulada"
# (datos sinteticos, solo si la API no esta disponible; ver README).
FUENTE_CALIDAD_AIRE=openaq
