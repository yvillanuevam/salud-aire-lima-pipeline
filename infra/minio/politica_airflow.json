{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListarSoloElBucketDelProyecto",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::salud-aire-datalake"]
    },
    {
      "Sid": "LeerYEscribirObjetosSinBorrar",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": ["arn:aws:s3:::salud-aire-datalake/*"]
    }
  ]
}
